{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "standards_ref": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "standards_reference": {
      "type": "object",
      "properties": {
        "kind": {"const": "release"},
        "tag": {"type": "string", "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
        "resolved_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "required": ["kind", "tag", "resolved_sha"],
      "additionalProperties": false
    },
    "release_attestation": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_identity": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "root_exists": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "repository",
        "domain",
        "root_exists"
      ],
      "additionalProperties": false
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "guards": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/|.*\\\\|.*:|.*(?:^|/)\\.\\.(?:/|$)|.*(?:^|/)\\.(?:/|$))[^/]+(?:/[^/]+)*$"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "enum": [
              "file",
              "absent",
              "directory"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "kind"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/|.*\\\\|.*:|.*(?:^|/)\\.\\.(?:/|$)|.*(?:^|/)\\.(?:/|$))[^/]+(?:/[^/]+)*$"
          },
          "ownership": {
            "enum": [
              "exact_file",
              "managed_blocks",
              "create_only",
              "merge"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "before_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "after_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content": {
            "type": "string"
          },
          "diff": {
            "type": "string"
          },
          "action": {
            "enum": [
              "create",
              "update"
            ]
          }
        },
        "required": [
          "path",
          "ownership",
          "source",
          "rules",
          "before_sha256",
          "after_sha256",
          "content",
          "diff",
          "action"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "mode": {
      "enum": [
        "create",
        "adopt"
      ]
    },
    "unchanged": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/|.*\\\\|.*:|.*(?:^|/)\\.\\.(?:/|$)|.*(?:^|/)\\.(?:/|$))[^/]+(?:/[^/]+)*$"
      },
      "uniqueItems": true
    },
    "validated_input": {
      "$ref": "integration-input.schema.json"
    }
  },
  "required": [
    "schema_version",
    "target_identity",
    "input_digest",
    "guards",
    "operations",
    "pending",
    "conflicts",
    "mode",
    "unchanged",
    "validated_input"
  ],
  "anyOf": [
    {"required": ["standards_ref"]},
    {"required": ["standards_reference", "release_attestation"]}
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
